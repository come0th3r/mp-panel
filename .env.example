# Copy to .env and replace all example values. Never commit .env.
# Generate URL-safe database password with: openssl rand -hex 32
POSTGRES_PASSWORD=
MP_PUBLIC_URL=https://panel.example.com
# Agents reach a dedicated end-to-end mTLS listener; no ordinary HTTP proxy here.
MP_AGENT_PUBLIC_URL=https://agents.example.com:8443
# Paper requires a genuine product identity plus contact URL or email.
MP_DOWNLOAD_USER_AGENT=MP-Panel/0.1 (https://your-real-domain.example/contact)
MP_COOKIE_SECURE=true
MP_WEB_BIND=127.0.0.1
MP_WEB_PORT=8080
MP_AGENT_BIND=0.0.0.0
MP_AGENT_PORT=8443
# Keep this many successful update recovery copies; cleanup runs only after a successful update.
MP_UPDATE_BACKUPS=1
# Shared Docker build cache only, not application images or volumes. Set false to keep it.
MP_PRUNE_BUILD_CACHE=true
# Game port binding is configured separately for each node in the SSH form.
# Optional NPM Docker network; enables compose.npm.yaml in the SSH installer.
# MP_NPM_NETWORK=nginx-proxy-manager_default
# Optional game gateway; defaults to Gate Lite.
# MP_ENABLE_GATEWAY=true
# MP_GATEWAY_PROVIDER=mc-router
# mc-router selects compose.mc-router.yaml; gate selects compose.gate.yaml.
# MP_GAME_DOMAIN=mc.your-domain.ru
# MP_GATEWAY_BIND=0.0.0.0
# MP_GATEWAY_PORT=25565
